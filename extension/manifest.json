{
  "manifest_version": 3,
  "name": "Manga AutoScan Translator",
  "version": "0.1.0",
  "description": "Auto-scan manga images, send to local OCR+LLM server, and overlay translations.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "commands"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manga AutoScan"
  },
  "commands": {
    "toggle-auto-scan": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle Auto-scan"
    },
    "capture-now": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Capture current image now"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
